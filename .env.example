# Every value here is optional — AI Doctor boots with no configuration at all.

ENVIRONMENT=development

# Metadata store. SQLite by default; a postgresql:// URL is used verbatim.
DATABASE_URL=sqlite:///./data/aidoctor.db

# Vector store: memory | qdrant. Qdrant defaults to embedded mode (no server).
VECTOR_BACKEND=qdrant
QDRANT_COLLECTION=aidoctor
# QDRANT_URL=http://localhost:6333      # set to use a Qdrant server instead

# Embeddings: hashing (offline, default) | openai
EMBEDDER=hashing
EMBEDDING_DIMENSIONS=384

# Reranker: none | lexical-overlap (default) | cross-encoder
RERANKER=lexical-overlap

# Generator: extractive (offline, default) | openai
LLM=extractive
# OPENAI_API_KEY=sk-...                 # required only for the openai backends

CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150
CANDIDATE_K=12
CONTEXT_K=4

# Answers below this reranked score are refused rather than guessed.
MIN_RELEVANCE=0.15

MAX_UPLOAD_MB=25
